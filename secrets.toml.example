# Copie este arquivo para .streamlit/secrets.toml (uso local) ou cole o
# mesmo conteúdo na aba "Secrets" do app no Streamlit Community Cloud.
# NUNCA comite o secrets.toml de verdade — ele já está no .gitignore.

GOOGLE_SHEETS_ID = "COLOQUE_AQUI_O_ID_DA_PLANILHA"

# Senha de acesso ao dashboard (tela de login em auth.py). Escolha uma
# senha forte e compartilhe só com quem deve ver os dados — não deixe o
# valor de exemplo abaixo.
APP_PASSWORD = "escolha-uma-senha-forte-aqui"

# Cole aqui, campo por campo, o conteúdo do arquivo JSON baixado ao criar
# a chave da conta de serviço no Google Cloud Console.
[gcp_service_account]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "SUA_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
client_email = "seu-service-account@SEU_PROJECT_ID.iam.gserviceaccount.com"
client_id = "SEU_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "URL_DO_CERTIFICADO_DA_CONTA_DE_SERVICO"
